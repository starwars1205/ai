#Use BFS to solve a planning problem. Examples can be: 8 puzzle problem

from collections import deque

grid = [
    ['S', '0', '0'],
    ['X', '0', 'X'],
    ['0', '0', 'E']
]

start = (0, 0)
goal = (2, 2)

queue = deque([(start, [start])])
visited = {start}

while queue:
    (r, c), path = queue.popleft()

    if (r, c) == goal:
        print("Path:", path)
        print("Steps:", len(path) - 1)
        break

    for dr, dc in [(0, 1), (1, 0), (0, -1), (-1, 0)]:
        nr, nc = r + dr, c + dc

        if (0 <= nr < 3 and 0 <= nc < 3
            and grid[nr][nc] != 'X'
            and (nr, nc) not in visited):

            visited.add((nr, nc))
            queue.append(((nr, nc), path + [(nr, nc)]))
else:
    print("No path found")
